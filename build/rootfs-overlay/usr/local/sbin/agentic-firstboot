#!/usr/bin/env bash
#
# Runs on every boot; the per-unit half runs only once.
#
# One image is copied byte-for-byte onto every unit, so anything that must
# differ between units cannot be baked in and has to be generated here, on
# the device, the first time it powers on.
#
# Split into two parts on purpose:
#   - once  -- identity: host keys, bearer token, filesystem size
#   - every -- identity re-pinning: the constitution is declarative and
#              must survive the agent editing its own soul at runtime

set -euo pipefail

STAMP=/var/lib/agentic-os/.firstboot-done
ENV_FILE=/etc/agentic-os/hermes.env
KEYS_FILE=/etc/agentic-os/cloud-keys.toml
SHARE=/usr/local/share/agentic-os

log() { printf 'agentic-firstboot: %s\n' "$*"; }

# The agent runs as the device owner, so its home is theirs. Resolved
# rather than hardcoded: the account name is chosen at build time, and a
# wrong guess here would silently write the identity somewhere nothing
# reads. First non-system account with a real home is the owner.
DEVICE_USER="$(awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }' /etc/passwd)"
if [ -z "$DEVICE_USER" ]; then
    log "WARNING: no device owner account found -- skipping identity pinning"
    HERMES_HOME=""
else
    HERMES_HOME="/home/$DEVICE_USER/.hermes"
fi

# ---------------------------------------------------------------------------
# Every boot: re-pin the agent's identity
# ---------------------------------------------------------------------------
# The constitution IS the identity and stays declarative, so the agent's
# runtime soul-editing never survives a reboot. Name and persona are
# applied per-turn by the shell instead, which is why overwriting this
# file does not erase what the owner set up.
if [ -n "$HERMES_HOME" ] && [ -f "$SHARE/constitution.md" ]; then
    install -D -m 600 -o "$DEVICE_USER" -g "$DEVICE_USER" \
        "$SHARE/constitution.md" "$HERMES_HOME/SOUL.md"
fi

if [ -n "$HERMES_HOME" ] && [ -d "$SHARE/skills" ]; then
    for skill_dir in "$SHARE/skills"/*/; do
        [ -d "$skill_dir" ] || continue
        name="$(basename "$skill_dir")"
        install -D -m 600 -o "$DEVICE_USER" -g "$DEVICE_USER" \
            "$skill_dir/SKILL.md" \
            "$HERMES_HOME/skills/$name/SKILL.md"
    done
fi

# ---------------------------------------------------------------------------
# Once per unit
# ---------------------------------------------------------------------------
if [ -f "$STAMP" ]; then
    exit 0
fi

log "first boot -- generating per-unit identity"

# --- SSH host keys ---------------------------------------------------------
# Stripped from the image: identical keys across a fleet would let any
# unit impersonate any other.
if [ -z "$(ls -A /etc/ssh/ssh_host_* 2>/dev/null)" ]; then
    log "generating ssh host keys"
    ssh-keygen -A
fi

# --- root filesystem -------------------------------------------------------
# The image is sized for the smallest disk the product ships on, so on
# anything larger the rest of the disk is unallocated until now.
root_src="$(findmnt -no SOURCE /)"
if [ -n "$root_src" ]; then
    root_disk="$(lsblk -no PKNAME "$root_src" 2>/dev/null | head -n1 || true)"
    # The partition number, from sysfs rather than an lsblk column: the
    # column names for this differ between util-linux versions, and
    # /sys/class/block/<dev>/partition is stable across all of them.
    root_part="$(cat "/sys/class/block/$(basename "$root_src")/partition" 2>/dev/null || true)"
    if [ -n "$root_disk" ] && [ -n "$root_part" ]; then
        log "growing root filesystem"
        # Both are no-ops when the partition already fills the disk, and
        # both exit non-zero to say so -- which is not a failure here.
        growpart "/dev/$root_disk" "$root_part" || \
            log "partition already full-size"
        resize2fs "$root_src" || log "filesystem already full-size"
    else
        log "could not resolve root partition -- filesystem not grown"
    fi
fi

# --- agent credentials -----------------------------------------------------
# The bearer token is per-unit and mandatory. The cloud key is optional:
# an image with no vendor key is a normal image, and the owner supplies
# their own through the UI.
#
# These were once written together, which meant a non-provisioned image
# shipped no env file at all and the agent could not authenticate against
# its own gateway. Written unconditionally now.
or_key=""
if [ -f "$KEYS_FILE" ]; then
    or_key="$(sed -n 's/^api_key *= *"\(.*\)"/\1/p' "$KEYS_FILE" | head -n1)"
    if [ -z "$or_key" ]; then
        log "WARNING: could not parse api_key from $KEYS_FILE"
    else
        log "using vendor-provisioned cloud key"
    fi
else
    log "no vendor cloud key; the owner supplies one through the interface"
fi

# The agent owns this file outright: it runs as the owner, reads
# $HERMES_HOME/.env directly (get_hermes_home() / ".env"), and is the only
# thing that needs the credentials. Written there as a plain 0600 file
# rather than somewhere root-owned -- a `hermes` command run in a terminal
# has to be able to read it, and a root-owned file with a group ACL only
# works if the group is active in that shell, which is exactly the
# "permission denied" this used to produce.
if [ -n "$HERMES_HOME" ]; then
    AGENT_ENV="$HERMES_HOME/.env"
    install -d -m 700 -o "$DEVICE_USER" -g "$DEVICE_USER" "$HERMES_HOME"
    install -m 600 -o "$DEVICE_USER" -g "$DEVICE_USER" /dev/null "$AGENT_ENV"
    {
        echo "OPENROUTER_API_KEY=$or_key"
        echo "API_SERVER_KEY=$(head -c 32 /dev/urandom | sha256sum | cut -c1-48)"
    } > "$AGENT_ENV"

    # systemd's EnvironmentFile= cannot expand a home directory, so the
    # unit points at a fixed path. Linked, not copied: one per-unit token,
    # one file, no chance of the two drifting apart.
    install -d -m 755 "$(dirname "$ENV_FILE")"
    ln -sfn "$AGENT_ENV" "$ENV_FILE"
else
    # No owner account resolved -- write the file the service reads so the
    # gateway can still authenticate, even though the CLI will not see it.
    install -D -m 600 -o root -g root /dev/null "$ENV_FILE"
    {
        echo "OPENROUTER_API_KEY=$or_key"
        echo "API_SERVER_KEY=$(head -c 32 /dev/urandom | sha256sum | cut -c1-48)"
    } > "$ENV_FILE"
fi

# --- machine-id ------------------------------------------------------------
# systemd regenerates this itself from the empty file left in the image;
# checked rather than assumed, because a fleet sharing one machine-id
# breaks anything keyed on it.
if [ ! -s /etc/machine-id ]; then
    systemd-machine-id-setup
fi

mkdir -p "$(dirname "$STAMP")"
date -Iseconds > "$STAMP"
log "per-unit setup complete"
