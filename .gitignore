/agent-core/*/target/
/agent-core/*/.venv/

# Golden image build artifacts -- multi-GB, rebuilt from build/ on demand
build/rootfs/
build/*.img
build/*.img.zst
__pycache__/
.pytest_cache/
.playwright-mcp/

# Local dev cloud key file (AGENTIC_OS_CLOUD_KEYS_FILE target) -- real secrets, never committed
cloud-keys.toml

# Nuxt/Tauri build outputs (ui/)
ui/dist/
ui/.output/
ui/.nuxt/
tasks/
